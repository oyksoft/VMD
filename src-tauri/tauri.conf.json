{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VMD",
  "version": "0.1.0",
  "identifier": "com.vmd.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VMD - Markdown Viewer",
        "width": 1200,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
