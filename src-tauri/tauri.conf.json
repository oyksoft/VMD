{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VMD",
  "version": "0.2.4",
  "identifier": "com.vmd.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "VMD - Markdown 编辑器",
        "width": 1200,
        "height": 720,
        "minWidth": 960,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
